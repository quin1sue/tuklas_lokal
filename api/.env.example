# Tuklas Lokal backend environment template.
# Copy to `.env` for local development: cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.
# Leave values blank here; put actual credentials only in your local `.env`.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
# Address/port the local backend listens on. Keep local-only unless testing on a device.
API_HOST=127.0.0.1
API_PORT=8000

# External provider credentials (remaining provisional until provider validation)
# Vision/image clue extraction (see docs/DECISIONS.md, D-007)
GEMINI_API_KEY=
# Place search/details provider
GOOGLE_PLACES_API_KEY=
